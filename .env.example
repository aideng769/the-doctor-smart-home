# Copy this file to .env and fill in real values for YOUR OWN network/setup.
#
# WHAT ACTUALLY READS THIS FILE, AND WHAT DOESN'T:
#
# - Docker Compose reads .env automatically (must be in the same folder as
#   docker-compose.yml) and substitutes ${VAR} inside that file. The
#   MQTT_USERNAME/MQTT_PASSWORD values below are passed through to the
#   frigate container's environment this way, and Frigate's own config.yml
#   resolves them automatically via its {FRIGATE_*} syntax - genuinely
#   zero manual editing for those two values.
#
# - Home Assistant does NOT read this .env file. Its own equivalent is
#   secrets.yaml (desktop/homeassistant/secrets.yaml) - copy the values
#   below into THAT file's format instead. A few lines in automations.yaml
#   are inside Jinja template strings, which !secret can't reach - those are
#   marked "MANUAL EDIT" directly in automations.yaml and must be hand-edited.
#
# - Frigate's go2rtc stream URL (laptop IP + camera device name) is not a
#   documented Frigate substitution field - also a manual edit, flagged in
#   desktop/frigate/config/config.yml.
#
# - go2rtc.yaml (laptop) and the VPN scripts (vpn/) read plain config files,
#   not .env - same manual-edit pattern, flagged in those files directly.
#
# See README.md for the full list of exactly what's automatic vs manual.

# --- Networking (manual edit - see config.yml / go2rtc.yaml / automations.yaml) ---
DESKTOP_LAN_IP=192.168.1.100
LAPTOP_LAN_IP=192.168.1.101
LAN_SUBNET=192.168.1.0/24

# --- Mosquitto / MQTT (these two ARE automatic via docker-compose.yml -> Frigate) ---
MQTT_USERNAME=smarthome
MQTT_PASSWORD=

# --- go2rtc (laptop) - manual edit in laptop/go2rtc.yaml ---
GO2RTC_USERNAME=smarthome
GO2RTC_PASSWORD=
CAMERA_DEVICE_NAME=

# --- Camera label (NOT auto-substituted - it's a YAML key / HA entity ID in
# several files, which .env can't fill in). Documented here as a reference
# only: rename every "your_camera" to this same value, by hand, in
# laptop/go2rtc.yaml, desktop/frigate/config/config.yml,
# desktop/homeassistant/configuration.yaml, and automations.yaml. ---
CAMERA_NAME=your_camera

# --- Home Assistant - copy these into desktop/homeassistant/secrets.yaml, ---
# --- and the Jinja-embedded ones into automations.yaml's MANUAL EDIT spots ---
PHONE_NOTIFY_SERVICE=mobile_app_your_phone
NANOLEAF_ENTITY_ID=light.shapes_xxxx
HA_SECRETS_SOME_PASSWORD=

# Note: no Windows/WSL2 username variable is needed - laptop/wsl2/run-satellite.sh
# uses $HOME, which resolves to your own username automatically on any machine.

# Tailscale VPN variables are intentionally not included yet - that module
# (vpn/, docs/vpn-plan.md) is being added in a later push.
